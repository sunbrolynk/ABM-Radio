#!/usr/bin/env bash
# abm-radio hook: installed and kept up to date by scripts/install-hooks.sh
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
head_sha="$(git rev-parse HEAD)"
pushing_code=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_sha" =~ ^0+$ ]]; then
        continue
    fi
    pushing_code=1
    if [[ "$local_sha" != "$head_sha" ]]; then
        echo "Push blocked: check out the branch being pushed so its files are tested." >&2
        exit 1
    fi
done

if [[ "$pushing_code" == 0 ]]; then
    exit 0
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Push blocked: commit or stash pending changes before validation." >&2
    git status --short
    exit 1
fi

echo "Checking Git history for secrets..."
bash scripts/check-secrets.sh

echo "Checking Git history is fit for a public repo..."
bash scripts/check-public.sh --history

echo "Checking every script change has a changelog entry..."
bash scripts/check-changelog.sh

echo "Linting the scripts and tests..."
# Each branch's own pyproject.toml decides whether ruff runs, so a branch from before the lint gate isn't held to it.
# A worktree without its own tooling venv uses the main checkout's.
ruff=.venv-tooling/bin/ruff
[[ -x "$ruff" ]] || ruff="$(git rev-parse --path-format=absolute --git-common-dir)/../.venv-tooling/bin/ruff"
if [[ ! -f pyproject.toml ]]; then
    echo "No pyproject.toml on this branch, so no lint gate to run."
elif [[ ! -x "$ruff" ]]; then
    echo "ruff is missing: run bash scripts/setup-tooling.sh once, then retry." >&2
    exit 1
else
    "$ruff" check scripts/ tests/
fi

echo "Running the script tests..."
python3 -m unittest discover -s tests

echo "Validating the catalog..."
python3 scripts/validate.py

if [[ "$(git rev-parse HEAD)" != "$head_sha" || -n "$(git status --porcelain)" ]]; then
    echo "Push blocked: repository changed during validation. Review and retry." >&2
    exit 1
fi

echo "Local validation passed; allowing push."
