#!/usr/bin/env bash
# abm-radio hook: installed and kept up to date by scripts/install-hooks.sh
# Blocks a commit that stages a secret, home-network details, writing that isn't mine, or a broken catalog.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "Scanning staged changes for secrets..."
bash scripts/check-secrets.sh --staged

echo "Checking staged files are fit for a public repo..."
bash scripts/check-public.sh

# Validate exactly what is being committed (the index git hands the hook, which for git commit -a
# or a path-limited commit is not the usual one), not the working files.
echo "Validating the catalog..."
snapshot="$(mktemp -d)"
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
python3 "$snapshot/scripts/validate.py"

echo "Linting the staged scripts and tests..."
# Each branch's own pyproject.toml decides whether ruff runs, so a branch from before the lint gate isn't held to it.
# A worktree without its own tooling venv uses the main checkout's.
ruff=.venv-tooling/bin/ruff
[[ -x "$ruff" ]] || ruff="$(git rev-parse --path-format=absolute --git-common-dir)/../.venv-tooling/bin/ruff"
if [[ ! -f "$snapshot/pyproject.toml" ]]; then
    echo "No pyproject.toml on this branch, so no lint gate to run."
elif [[ ! -x "$ruff" ]]; then
    echo "ruff is missing: run bash scripts/setup-tooling.sh once, then retry." >&2
    exit 1
else
    "$ruff" check --no-cache --config "$snapshot/pyproject.toml" "$snapshot/scripts/" "$snapshot/tests/"
fi
